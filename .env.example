# Leave DATABASE_URL unset to run on SQLite with zero setup.
# Postgres:   postgresql+psycopg://user:pass@host/db
# TimescaleDB: same URL, plus TIMESCALE_ENABLED=true to create hypertables
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/resort360
# TIMESCALE_ENABLED=false

# Celery broker + cache. Unreachable -> Celery runs eager, app still works.
REDIS_URL=redis://localhost:6379/0

# Concierge + review summarisation. Unset -> grounded extractive fallback.
# ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5

FORECAST_HORIZON_DAYS=30

# Keep-alive self-ping. Unset locally -> dormant. On Render the target is taken
# from the injected RENDER_EXTERNAL_URL, so only override to ping elsewhere.
# KEEPALIVE_URL=https://your-service.onrender.com
# KEEPALIVE_ENABLED=true
# KEEPALIVE_INTERVAL_SECONDS=600

# --------------------------------------------------------------------------
# Identity. "token:Display Name:role" triples, comma-separated.
# Roles: gm | revenue_manager | ops_manager | duty_manager | analyst | viewer
# UNSET = open demo mode: anyone who can reach the API can approve anything,
# and the audit log records "Demo Manager (unauthenticated)". Always set this
# on a public deployment.
# AUTH_USERS=s3cret-gm:Ravi Menon:gm,s3cret-rev:Priya Nair:revenue_manager

# Operating day is resolved in this timezone, not the server's. A UTC host
# serving an Indian resort had "today" wrong from midnight to 05:30 local.
RESORT_TIMEZONE=Asia/Kolkata

# Trust ramp. true = approvals are recorded and previewed but write nothing,
# so a property can watch the system for a month before letting it act.
SHADOW_MODE=false
UNDO_WINDOW_MINUTES=30

# --------------------------------------------------------------------------
# Notifications - the last mile. Without these an approved action changes the
# database and nobody is told. "console" logs instead of sending, which is the
# right default for local work.
# Channels: console | email | sms | whatsapp | webhook  (comma-separated)
NOTIFY_CHANNELS=console

# Where unrouted and manager-facing alerts go (critical cards, POs, escalations).
# DUTY_MANAGER_EMAIL=duty@your-resort.example
# DUTY_MANAGER_PHONE=+919000000000

# Email (SMTP). Unset -> email messages fall back to console.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# NOTIFY_FROM_EMAIL=ops@your-resort.example

# SMS / WhatsApp (Twilio). Unset -> those channels fall back to console.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+14155550100
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Generic JSON POST - Slack, Teams, or an in-house app.
# NOTIFY_WEBHOOK_URL=

# Cold start: below this much history the UI marks recommendations provisional.
MIN_HISTORY_DAYS_TRUSTED=365
